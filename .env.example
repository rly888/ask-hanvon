# ========= 问小汉 · 环境变量示例 =========
# 复制为 .env 或直接写入系统环境变量。所有凭据只从环境变量读取，禁止写入源码。

# ---- 服务 ----
DATA_DIR=./data
HOST=0.0.0.0
PORT=8300
# JWT 签名密钥（生产必须修改；不设置时服务端会生成随机密钥存于 data 目录）
JWT_SECRET=
TOKEN_TTL_HOURS=72

# ---- LLM 模型网关（OpenAI 兼容协议）----
# 未配置 Key 时系统自动进入「离线兜底模式」，整条链路仍可运行
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_STRONG_MODEL=glm-4.5-flash
LLM_WEAK_MODEL=glm-4-flash
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=60

# ---- Embedding（留空则使用本地轻量向量，无需联网）----
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIM=256

# ---- Rerank（留空则使用本地词面重排）----
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=

# ---- 引导管理员（seed 时使用；不设置则随机生成并打印一次）----
ADMIN_PASSWORD=

# ---- 配额与限流 ----
QUOTA_LLM_CALLS_PER_USER_DAY=300
QUOTA_LLM_TOKENS_PER_USER_DAY=200000
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_API_PER_MIN=120

# ---- 日志 ----
LOG_LEVEL=INFO
